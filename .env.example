NODE_ENV=development
PORT=3000
POSTGRES_USER=zasshealth
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_DB=zasshealth
POSTGRES_PORT=5432
# Host-side Prisma uses localhost; Docker Compose overrides the host to db.
# Use URL-safe database credentials, or URL-encode credentials in DATABASE_URL.
DATABASE_URL=postgresql://zasshealth:CHANGE_ME_database_password@localhost:5432/zasshealth?schema=public
JWT_ACCESS_SECRET=CHANGE_ME_use_at_least_32_random_characters
OTP_HASH_SECRET=CHANGE_ME_use_a_different_32_character_secret
# Optional: blank disables SUPER_ADMIN registration. Remove after provisioning admins.
ADMIN_INVITE_SECRET=
# development returns codes in responses; forbidden when NODE_ENV=production.
OTP_TRANSPORT=development
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
CORS_ORIGINS=http://localhost:3001

DEV_FIXED_OTP=123456

SWAGGER_ENABLED=true

REDIS_URL=redis://localhost:6379

REDIS_PORT=6379

SEED_DEMO_DATA=true
